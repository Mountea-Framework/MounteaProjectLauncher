{
  "name": "mountea-project-launcher",
  "version": "0.1.0",
  "description": "Launcher for Unreal Engine projects",
  "license": "MPL-2.0",
  "main": "dist-electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.json --noEmit && vite build",
    "test": "node --test --experimental-strip-types electron/core/*.test.ts",
    "start": "electron .",
    "lint": "eslint . --ext .ts,.tsx --no-eslintrc --config eslint.typed.cjs --max-warnings 0 --report-unused-disable-directives",
    "lint:syntax": "eslint . --ext .ts,.tsx --max-warnings 0 --report-unused-disable-directives",
    "package:dir": "npm run build && electron-builder --dir --publish never",
    "package:mac": "npm run build && electron-builder --mac --universal --publish never",
    "package:win": "npm run build && electron-builder --win --publish never"
  },
  "dependencies": {
    "@radix-ui/react-context-menu": "2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-scroll-area": "^1.4.0",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "^0.468.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tailwind-merge": "2.5.5",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@types/node": "20.17.9",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@typescript-eslint/eslint-plugin": "8.72.1",
    "@typescript-eslint/parser": "8.72.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "electron": "33.2.0",
    "electron-builder": "26.18.0",
    "eslint": "8.57.1",
    "eslint-plugin-react-hooks": "5.2.0",
    "eslint-plugin-security": "3.0.1",
    "eslint-plugin-xss": "0.1.12",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.16",
    "typescript": "5.6.3",
    "vite": "5.4.11",
    "vite-plugin-electron": "0.28.8",
    "vite-plugin-electron-renderer": "0.14.6"
  },
  "build": {
    "appId": "com.mountea.projectlauncher",
    "productName": "Mountea Project Launcher",
    "asar": true,
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "dist-electron/**/*",
      "Config/*.json",
      "Icons/MPLIcon.*",
      "LICENSE",
      "package.json",
      "!node_modules/**/*"
    ],
    "artifactName": "${productName}-${version}-${os}-${arch}.${ext}",
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "Icons/MPLIcon.png",
      "category": "public.app-category.developer-tools",
      "minimumSystemVersion": "11.0"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "Icons/MPLIcon.ico"
    }
  }
}
